[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = NerveDeskDisplay.cat
DriverVer   = 10/20/2026, 1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
NerveDeskDisplay.dll = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceName% = NerveDeskDisplay_Install, Root\NerveDeskDisplay

[NerveDeskDisplay_Install.NT]
CopyFiles = NerveDeskDisplay_Files

[NerveDeskDisplay_Files]
NerveDeskDisplay.dll

[NerveDeskDisplay_Install.NT.Services]
AddService = WUDFRd, 0x000001fa, WUDFRd_ServiceInstall

[WUDFRd_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[NerveDeskDisplay_Install.NT.Wdf]
UmdfService              = NerveDeskDisplay, NerveDeskDisplay_Install_Umdf
UmdfServiceOrder         = NerveDeskDisplay
UmdfHostProcessSharing   = ProcessSharingDisabled

[NerveDeskDisplay_Install_Umdf]
UmdfLibraryVersion = 2.25.0
ServiceBinary      = %13%\NerveDeskDisplay.dll

[Strings]
ManufacturerName  = "NerveDesk Team"
DiskName          = "NerveDesk Virtual Display Installation Disk"
DeviceName        = "NerveDesk Virtual Display Adapter"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
