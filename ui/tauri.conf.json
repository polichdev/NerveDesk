{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NerveDesk",
  "version": "1.0.0",
  "identifier": "com.nervedesk.app",
  "build": {
    "frontendDist": "./"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": " ",
        "width": 1200,
        "height": 760,
        "minWidth": 460,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (C) 2026 NerveDesk",
    "shortDescription": "NerveDesk Virtual Display & KVM",
    "longDescription": "Ultra-low latency hybrid KVM and virtual display streaming application",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
