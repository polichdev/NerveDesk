[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Manufacturer%
CatalogFile=NerveDeskDisplay.cat
DriverVer=10/21/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%Manufacturer%=Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%DeviceName%=NerveDesk_Install,Root\NerveDeskDisplay

[SourceDisksFiles]
NerveDeskDisplay.dll=1

[SourceDisksNames]
1=%DiskName%,,,

[NerveDesk_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[NerveDesk_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DeviceSettings

[DeviceSettings]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"NerveDeskDisplayGroup"

[NerveDesk_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[NerveDesk_Install.NT.Wdf]
UmdfService=NerveDeskDisplay,NerveDeskDisplay_Service
UmdfServiceOrder=NerveDeskDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[NerveDeskDisplay_Service]
UmdfLibraryVersion=2.25.0
ServiceBinary=%12%\UMDF\NerveDeskDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=12,UMDF

[DriverCopy]
NerveDeskDisplay.dll

[Strings]
Manufacturer="NerveDesk"
DiskName="NerveDesk Virtual Display"
DeviceName="NerveDesk Virtual Display Adapter"
