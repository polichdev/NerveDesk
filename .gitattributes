# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows scripts and hooks require CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.nsh text eol=crlf

# Binary files must not have line endings modified
*.png binary
*.ico binary
*.icns binary
*.bmp binary
*.exe binary
*.dll binary
*.sys binary
*.cat binary
*.pdb binary
*.lib binary
